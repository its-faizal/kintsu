        <!-- Notification Receivers -->
        <receiver
            android:name=".notifications.ReminderAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".notifications.NotificationActionReceiver"
            android:exported="false" />

        <!-- Focus Foreground Service -->
        <service
            android:name=".focus.FocusForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Focus timer countdown session" />
        </service>

        <receiver
            android:name=".notifications.BootAndAlarmReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Digital Wellbeing Block Activity -->
        <activity
            android:name=".wellbeing.ui.BlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:resizeableActivity="false"
            android:supportsPictureInPicture="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:windowSoftInputMode="adjustNothing"
            android:theme="@style/Theme.Kintsu" />

        <!-- Reel & Short-Form Intervention Screen Overlay Activity -->
        <activity
            android:name=".wellbeing.ui.ReelInterventionOverlayActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity="com.kintsu.app.reelintervention"
            android:resizeableActivity="false"
            android:supportsPictureInPicture="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:noHistory="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:windowSoftInputMode="adjustNothing"
            android:theme="@style/Theme.Kintsu" />

        <!-- Notification Listener Service for Scheduled Notification Batching -->
        <service
            android:name=".wellbeing.service.KintsuNotificationListenerService"
            android:label="Kintsu Notification Batching"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Accessibility Blocker Service -->
        <service
            android:name=".wellbeing.service.KintsuAccessibilityBlockerService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Local DNS VPN Filter Service -->
        <service
            android:name=".wellbeing.service.KintsuVpnDnsFilterService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Device Admin Receiver for Optional Uninstall Friction -->
        <receiver
            android:name=".wellbeing.service.KintsuDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_config" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

